{
  // Autonodwell website on Cloudflare Workers (static assets + the inquiry form).
  // "name" must match the Worker's name in the Cloudflare dashboard.
  "name": "autonodwell",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Run worker.js before serving files, so autonodwell.com can redirect to www.
    "run_worker_first": true
  },
  // Keep the variables set in the dashboard (INQUIRY_TO, INQUIRY_FROM) when deploying.
  "keep_vars": true,
  // Worker logs (Observability → Logs), so a refused form email shows Resend's reason.
  "observability": { "enabled": true }
}
