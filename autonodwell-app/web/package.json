{
  "name": "autonodwell-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "gen:api": "cd ../api && python -c \"import json,app.main as m; json.dump(m.app.openapi(), open('../web/openapi.json','w'), indent=1)\" && cd ../web && openapi-typescript openapi.json --default-non-nullable false -o src/api/schema.d.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.90.0",
    "typescript": "~5.9",
    "vite": "^8.3.6"
  }
}