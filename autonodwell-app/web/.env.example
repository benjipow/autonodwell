# Leave the Firebase values empty to use local "dev" sign-in (works with the API's AUTH_MODE=dev).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Google Analytics measurement id (G-...). Empty leaves analytics off.
VITE_FIREBASE_MEASUREMENT_ID=
# Only set if the API is on a different origin than the web app (e.g. https://api.autonodwell.com)
VITE_API_BASE=
# Public privacy policy. Defaults to https://autonodwell.com/privacy when unset.
VITE_PRIVACY_URL=https://autonodwell.com/privacy
